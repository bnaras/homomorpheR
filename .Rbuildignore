^.*\.Rproj$
^\.Rhistory$
^\.Rproj\.user$
^\.travis\.yml$
^docs$
^_pkgdown\.yml$
^README\.Rmd$
^README-.*\.png$
^pkgdown$
^codecov\.yml$
^LICENSE\.md$
^NOTES\.md$
^CRAN-RELEASE$
^inst/stuff
^data-raw$
^\.github$
^\.git$
^paillier-archive$
# ── Local scratch that must never reach the tarball ──
#    Rplots.pdf is dropped by any non-interactive plot; the dated .txt
#    pattern matches saved session transcripts. Both showed up as a
#    "Non-standard files/directories found at top level" NOTE.
^Rplots\.pdf$
^[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{6}-.*\.txt$
#    figure/ is knitr's default fig.path, created whenever a vignette is
#    knitted directly from the package root (knitr::knit("vignettes/x.Rmd"))
#    rather than through R CMD build. Same NOTE, same cause: a local
#    verification step leaving an artifact where the tarball can see it.
^figure$
#    tools/ holds maintainer scripts (favicon regeneration) that are run
#    by hand from the package root. Nothing in the build or check path
#    reads them, so they have no business in the tarball.
^tools$
